// Pregón — esquema de datos
// Compose (Post) -> multi-destino (Publication) -> métricas en el tiempo (Metric)
// SQLite no tiene enums/arrays nativos: usamos strings + JSON.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Un proyecto del que difundimos (Lookspan, Regenta, etc.)
model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  url         String?
  description String?
  color       String? // hex para la UI
  npmPackage  String? // nombre del paquete en npm (para descargas)
  pypiPackage String? // nombre del paquete en PyPI (descargas vía pypistats)
  githubRepo  String? // owner/repo en GitHub (para stars/forks)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]
  notes ProjectNote[]
}

/// Registro de lo que hemos hablado/decidido sobre un proyecto:
/// mensajes clave, ángulos, ideas, pendientes. Es la "memoria de difusión".
model ProjectNote {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  kind      String   @default("note") // note | message | idea | decision | todo
  body      String
  createdAt DateTime @default(now())

  @@index([projectId])
}

/// Una cuenta conectada en una plataforma. Guarda credenciales CIFRADAS (AES-256-GCM).
model Account {
  id          String   @id @default(cuid())
  channel     String // id del adapter: 'telegram' | 'discord' | 'mastodon' | ...
  label       String // etiqueta legible, ej. "@joni@mastodon.social"
  credentials String // blob JSON cifrado (token, webhook, etc.)
  meta        String? // JSON NO secreto (instancia, chat id por defecto, etc.)
  status      String   @default("active") // active | disabled | error
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publications Publication[]
}

/// El mensaje canónico que queremos difundir (o el comentario a publicar).
model Post {
  id          String    @id @default(cuid())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  kind        String    @default("post") // post | comment
  title       String?
  body        String // texto/markdown canónico
  link        String? // enlace que promocionas (para kind=post)
  targetUrl   String? // URL del hilo donde responder (para kind=comment)
  tags        String? // JSON array
  images      String? // JSON array de urls/paths
  status      String    @default("draft") // draft | scheduled | publishing | published | partial | failed
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  publications Publication[]
  variants     Variant[]

  @@index([projectId])
}

/// Override de texto por canal (opcional). Si no existe, se usa Post.body.
model Variant {
  id      String @id @default(cuid())
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String
  channel String // id del adapter al que aplica
  body    String

  @@unique([postId, channel])
}

/// Un destino concreto de publicación = Post x canal (con cuenta opcional si es auto).
model Publication {
  id          String    @id @default(cuid())
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  channel     String // id del adapter destino (siempre presente)
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId   String? // solo canales auto con cuenta conectada
  status      String    @default("pending") // pending | published | failed | skipped
  externalId  String? // id devuelto por la plataforma
  externalUrl String? // permalink al post/comentario publicado
  error       String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  metrics Metric[]

  @@index([postId])
  @@index([accountId])
}

/// Snapshot de engagement en el tiempo (serie temporal).
model Metric {
  id            String      @id @default(cuid())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  publicationId String
  capturedAt    DateTime    @default(now())
  likes         Int?
  comments      Int?
  shares        Int?
  views         Int?
  score         Int? // upvotes / puntos (HN, Reddit, Product Hunt)
  raw           String? // payload crudo en JSON

  @@index([publicationId, capturedAt])
}
