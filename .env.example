# SQLite (Prisma)
DATABASE_URL="file:./dev.db"

# AES-256-GCM master key for encrypting account credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PREGON_MASTER_KEY=""

# Optional: GitHub Personal Access Token (read-only) to fetch stars/forks of
# PRIVATE repos and raise the API rate limit. Public repos work without it.
GITHUB_TOKEN=""
